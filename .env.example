# Copy this file to .env and fill in the values you plan to use.

# Core generation defaults
TEXT_PROVIDER=openai
TEXT_MODEL=gpt-5.5
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-2
SITE_ROOT=docs
NO_PUBLISH_JEKYLL=false
TO_EMAIL=your_kindle@kindle.com

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini / Imagen
GEMINI_API_KEY=AIza...

# Optional OpenAI-compatible providers
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
GROQ_API_KEY=
GROQ_TEXT_MODEL=
XAI_API_KEY=
XAI_TEXT_MODEL=

# SMTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=you@gmail.com

# IMAP trigger inbox
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=essay-trigger@gmail.com
IMAP_PASSWORD=your-imap-app-password
TRIGGER_RECIPIENT=essay-trigger@gmail.com
TRIGGER_ALLOWED_FROM=you@example.com
TRIGGER_MAILBOX=INBOX
TRIGGER_MAX_MESSAGES_PER_RUN=3
TRIGGER_MAX_PROMPT_CHARS=12000

# Optional trigger overrides
TRIGGER_TEXT_PROVIDER=
TRIGGER_TEXT_MODEL=
TRIGGER_IMAGE_PROVIDER=
TRIGGER_IMAGE_MODEL=
TRIGGER_EMAIL=
TRIGGER_SITE_ROOT=
TRIGGER_SYSTEM_PROMPT=
TRIGGER_NO_EMAIL=false
TRIGGER_NO_PUBLISH_JEKYLL=false
