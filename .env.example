# emailMeAnEssay – environment configuration
# Copy this file to .env and fill in your values.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── SMTP (outgoing email) ─────────────────────────────────────────────────────
# Gmail example: smtp.gmail.com / port 587 (STARTTLS) or 465 (SSL)
# Use an "App Password" if you have 2FA enabled on your Google account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: sender address shown in the From header (defaults to SMTP_USER)
FROM_EMAIL=you@gmail.com
